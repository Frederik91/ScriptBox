<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ScriptBox</PackageId>
    <Authors>ScriptBox</Authors>
    <Description>Let an AI model write JavaScript against your .NET API. ScriptBox runs it in a QuickJS WebAssembly sandbox inside your process, where it reaches only the methods you register, your filters check every call, and time and memory limits stop runaway code.</Description>
    <RepositoryUrl>https://github.com/FredTegnander/ScriptSandboxPoC</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>sandbox wasm javascript quickjs ai llm agents</PackageTags>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <!-- Suppress type conflict warnings from polyfills -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Wasmtime" Version="34.0.2" />
  </ItemGroup>

  <!-- Exclude polyfills for frameworks that have built-in async types -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Compile Remove="Polyfills\Netstandard20AsyncPolyfills.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.0" />
  </ItemGroup>

  <!-- The module is built with ScriptBox.Wasm/build.sh; both it and the bootstrap are loaded from these resources. -->
  <ItemGroup>
    <EmbeddedResource Include="..\scripts\sdk\scriptbox.js" Condition="Exists('..\scripts\sdk\scriptbox.js')" LogicalName="ScriptBox.Js.sandbox-api.js" />
    <EmbeddedResource Include="..\scripts\dist\sdk\bootstrap-utils.js" Condition="Exists('..\scripts\dist\sdk\bootstrap-utils.js')" LogicalName="ScriptBox.Js.bootstrap-utils.js" />
    <EmbeddedResource Include="..\ScriptBox.Wasm\scriptbox-async.wasm" LogicalName="ScriptBox.Wasm.scriptbox-async.wasm" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="." />
    <None Include="..\LICENSE" Link="LICENSE" Pack="true" PackagePath="." />
  </ItemGroup>

</Project>
